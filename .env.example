# Copy this file to .env and fill in real values. .env is git-ignored; this
# template is committed. Used by docker-compose.yml and the server.

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=quizgame
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=quizgame

# Connection string the API uses to reach the db service inside the Docker
# network. Host is the compose service name ("db"), not localhost.
ConnectionStrings__Default=Host=db;Port=5432;Database=quizgame;Username=quizgame;Password=change-me-strong-password

# ── JWT (shared signing key for GM and player tokens) ────────────────
# Generate a long random value, e.g. `openssl rand -base64 48`.
Jwt__Key=change-me-at-least-32-bytes-of-random-secret
Jwt__Issuer=quizgame
Jwt__Audience=quizgame

# ── Seed admin game master ───────────────────────────────────────────
# Created on first startup by the seeder (plan §5.2).
Seed__AdminUsername=admin
Seed__AdminPassword=change-me-admin-password

# ── App behaviour ────────────────────────────────────────────────────
# Set to false to disable POST /api/auth/register (only seeded hosts).
AllowRegistration=false

# ── TLS proxy (Caddy) ────────────────────────────────────────────────
# Optional. Off by default (compose profile "caddy"); we use a Cloudflare
# tunnel for public HTTPS. Only used if you run `docker compose --profile caddy up`.
SITE_ADDRESS=localhost

# ── Public URL (Cloudflare tunnel) ───────────────────────────────────
# The https://<name>.trycloudflare.com address the tunnel prints. Set it so
# room join links and the QR code point at the public URL. Leave empty for LAN.
PublicBaseUrl=

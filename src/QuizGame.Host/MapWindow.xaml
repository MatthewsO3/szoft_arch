<Window x:Class="QuizGame.Host.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategic Quiz — Map" Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Background="#14161F" Foreground="#F2F4F8" KeyDown="OnKeyDown">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="F11: fullscreen · Esc: exit fullscreen" Foreground="#9AA3B5" />
            <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" Foreground="#9AA3B5" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PickCountdown}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="#FFCA6A"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Visibility="{Binding HasActivePickCountdown, Converter={StaticResource B2V}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" FontSize="28" Foreground="#FFCA6A" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <ProgressBar Value="{Binding PickTimeRemainingFraction, Mode=OneWay}"
                         Maximum="1"
                         Height="10"
                         Margin="0,10,0,0"
                         Background="#2A2F42"
                         Foreground="#FFCA6A"
                         BorderThickness="0"
                         AutomationProperties.Name="Pick time remaining"
                         Visibility="{Binding HasActivePickCountdown, Converter={StaticResource B2V}}" />
        </StackPanel>

        <!-- Scoreboard -->
        <Border DockPanel.Dock="Right" Width="340" Margin="24,0,0,0" Background="#1E212D" CornerRadius="12" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Scores" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Scores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6">
                                <Ellipse DockPanel.Dock="Left" Width="18" Height="18" Fill="{Binding Color}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Points}" FontSize="22" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding Text}" FontSize="22" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Territory grid: fixed-size cells, scaled to the window by the Viewbox -->
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.Cols, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="110" Height="110" Margin="3" CornerRadius="10" Background="{Binding Fill}">
                            <Grid>
                                <TextBlock Text="{Binding Marker}" Foreground="{Binding TextBrush}" FontSize="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Caption}" Foreground="{Binding TextBrush}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="6,0,6,10" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>
    </DockPanel>
</Window>

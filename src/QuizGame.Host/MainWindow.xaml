<Window x:Class="QuizGame.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:QuizGame.Host.Views"
        Title="Strategic Quiz – Game Master"
        Width="1040" Height="740" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="PopInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                             From="1" To="1.12" Duration="0:0:0.08" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                             From="1" To="1.12" Duration="0:0:0.08" AutoReverse="True" />
        </Storyboard>

        <Style x:Key="AttentionBannerStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <RotateTransform Angle="0" />
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowQuestionSelectionBanner}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PopInAnimation}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,16,24,16">
        <!-- Account and connection header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowRoom, Converter={StaticResource B2V}}">
                <TextBlock Text="Signed in as " Foreground="Gray" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Command="{Binding LogoutCommand}" Padding="10,4" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="LogOut" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Log out" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap"
                       HorizontalAlignment="Right" TextAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Login -->
        <StackPanel Visibility="{Binding ShowLogin, Converter={StaticResource B2V}}"
                    MaxWidth="360" VerticalAlignment="Center">
            <TextBlock Text="Game Master login" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock Text="Server URL" Margin="0,0,0,2" />
            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" />

            <TextBlock Text="Username" Margin="0,0,0,2" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" />

            <TextBlock Text="Password" Margin="0,0,0,2" />
            <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Padding="6" Margin="0,0,0,16" />

            <Button  Command="{Binding LoginCommand}" IsDefault="True" Padding="12,8">

                <StackPanel Orientation="Horizontal">

                    <icons:PackIconLucide Kind="LogIn" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Text="Log in" VerticalAlignment="Center" />

                </StackPanel>

            </Button>
        </StackPanel>

        <!-- Logged-in host workspace -->
        <DockPanel Visibility="{Binding ShowRoom, Converter={StaticResource B2V}}">
            <views:PhaseControlView DockPanel.Dock="Bottom"
                                    DataContext="{Binding PhaseControl}"
                                    IsEnabled="{Binding HasRoom}"
                                    Margin="0,16,0,0">
                <views:PhaseControlView.Style>
                    <Style TargetType="views:PhaseControlView">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </views:PhaseControlView.Style>
            </views:PhaseControlView>

            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Room / Lobby">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button  Click="OpenQuestionWindow" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Projector" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Projector" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button  Click="OpenMapWindow" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Map" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Map" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button  Command="{Binding CreateRoomCommand}" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Create room" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button  Command="{Binding CloseRoomCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="DoorClosed" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Close room" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        Visibility="{Binding HasNoRoom, Converter={StaticResource B2V}}"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="24"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Configure room settings on the right, then click Create room to open a lobby."
                                               Foreground="Gray"
                                               FontSize="15"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Row="0" Margin="0,8,0,0" Visibility="{Binding HasRoom, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Room code" Foreground="Gray" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RoomCodeText" Text="{Binding RoomCode}" FontSize="64" FontWeight="Bold" FontFamily="Consolas"
                                                   VerticalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="0" />
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </TransformGroup>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                                        </TextBlock>
                                        <Button Command="{Binding CopyRoomCodeCommand}"
                                                Click="CopyRoomCode_Click"
                                                Width="32" Height="32"
                                                Padding="7"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Copy room code"
                                                ToolTip="Copy room code to clipboard">
                                            <icons:PackIconLucide Width="16" Height="16">
                                                <icons:PackIconLucide.Style>
                                                    <Style TargetType="icons:PackIconLucide">
                                                        <Setter Property="Kind" Value="Copy" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CopyRoomCodeText}" Value="Copied!">
                                                                <Setter Property="Kind" Value="Check" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </icons:PackIconLucide.Style>
                                            </icons:PackIconLucide>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,4,0,0" Visibility="{Binding HasRoom, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Players join at (open on a phone, or use the code on the start page):"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                    <TextBox Text="{Binding JoinUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             HorizontalAlignment="Center" FontSize="15" />
                                </StackPanel>

                                <GroupBox Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding HasRoom, Converter={StaticResource B2V}}">
                                    <GroupBox.Header>
                                        <TextBlock Text="{Binding PlayerCountText}" FontWeight="SemiBold" />
                                    </GroupBox.Header>
                                    <ListBox ItemsSource="{Binding Players}" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TransformGroup>
                                                            <RotateTransform Angle="0" />
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </TransformGroup>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource PopInAnimation}" />
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2">
                                                    <Button DockPanel.Dock="Right"  Padding="10,2"
                                                            Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:PackIconLucide Kind="UserMinus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Kick" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="Gray"
                                                               Margin="0,0,16,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="14" Height="14" Fill="{Binding ColorHex}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding BaseRankText, Mode=OneWay}" Foreground="Gray" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </GroupBox>
                            </Grid>

                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <views:RoomSettingsView DataContext="{Binding RoomSettings}" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Question bank">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12">
                            <Border DockPanel.Dock="Right"
                                    Background="#FEF3C7"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,7"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AttentionBannerStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Hourglass"
                                                           Width="16"
                                                           Height="16"
                                                           VerticalAlignment="Center"
                                                           Foreground="#92400E"
                                                           Margin="0,0,7,0" />
                                    <TextBlock Text="Your turn to send a question"
                                               Foreground="#92400E"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                </StackPanel>
                            </Border>
                            <WrapPanel>
                                <Button  Command="{Binding SendQuestionCommand}"
                                         Style="{StaticResource PrimaryActionButton}"
                                         Padding="14,8"
                                         Margin="0,0,8,0"
                                         FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Send" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SendQuestionButtonText, Mode=OneWay}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button  Command="{Binding CloseRoundCommand}" Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="CircleStop" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Close round" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button  Click="OpenQuestionWindow" Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Projector" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Projector" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button  Click="OpenMapWindow" Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Map" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Map" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#FEF2F2"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="12,0,12,0"
                                Visibility="{Binding HasDuelNomination, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Info"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="#991B1B"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DuelNominationText, Mode=OneWay}"
                                           Foreground="#991B1B"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <views:QuestionBankView DataContext="{Binding QuestionBank}" Margin="12" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>

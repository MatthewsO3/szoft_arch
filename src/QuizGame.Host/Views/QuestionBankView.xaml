<UserControl x:Class="QuizGame.Host.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Action toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button  Command="{Binding ManageCategoriesCommand}" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Tags" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Categories…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button  Command="{Binding RefreshCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="RefreshCw" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button  Command="{Binding AddQuestionCommand}" Padding="14,6" Margin="0,0,8,0" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="New question" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button  Command="{Binding EditQuestionCommand}" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Pencil" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Edit" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button  Command="{Binding DeleteQuestionCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Trash2" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Delete" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Filter bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding CategoryFilters}"
                      SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Padding="6,5"
                      Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Padding="6,5"
                      Margin="0,0,8,0" />

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding DifficultyFilters}"
                      SelectedItem="{Binding SelectedDifficultyFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Padding="6,5"
                      Margin="0,0,8,0" />

            <TextBox Grid.Column="3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,5"
                     Margin="0,0,8,0"
                     ToolTip="Search question text">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="4"  Command="{Binding SearchCommand}" Padding="12,5" Margin="0,0,6,0">

                <StackPanel Orientation="Horizontal">

                    <icons:PackIconLucide Kind="Search" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Text="Search" VerticalAlignment="Center" />

                </StackPanel>

            </Button>
            <Button Grid.Column="5"  Command="{Binding ClearFiltersCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="X" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Questions grid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <CheckBox DockPanel.Dock="Right" Content="Manage all questions"
                          IsChecked="{Binding ManageAllQuestions}" Margin="12,0,0,0"
                          ToolTip="Allow selecting any question for editing. Sending still requires the correct type for the current phase." />
                <TextBlock Text="{Binding QuestionTypeGuidance}" TextWrapping="Wrap" Foreground="#92400E" />
            </DockPanel>
            <DataGrid x:Name="QuestionsGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding Questions}"
                      SelectedItem="{Binding SelectedQuestion, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="30"
                      MouseDoubleClick="QuestionsGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <!-- Context menus live outside the window's visual tree; pass the command through the row. -->
                        <Setter Property="Tag" Value="{Binding DataContext.SendQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <EventSetter Event="ContextMenuOpening" Handler="QuestionRow_ContextMenuOpening" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Send question"
                                              Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <icons:PackIconLucide Kind="Send" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Question" Binding="{Binding Text}" Width="*" MinWidth="220" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="115" IsReadOnly="True" />
                    <DataGridTextColumn Header="Difficulty" Binding="{Binding DifficultyDisplay}" Width="95" IsReadOnly="True" />
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeLimitDisplay}" Width="65" IsReadOnly="True" />
                    <DataGridTextColumn Header="Answer" Binding="{Binding AnswerSummary}" Width="170" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No questions match the current filters."
                       Grid.Row="1"
                       Visibility="{Binding HasNoQuestions, Converter={StaticResource B2V}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontSize="14"
                       IsHitTestVisible="False" />

            <Border Visibility="{Binding IsLoading, Converter={StaticResource B2V}}"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,34,12,0"
                    Padding="8,4"
                    Background="#F3F4F6"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsHitTestVisible="False">
                <TextBlock Text="Loading…" Foreground="#374151" FontSize="12" />
            </Border>
        </Grid>

        <!-- Footer: summary, errors, pagination -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding SummaryText, Mode=OneWay}"
                       Foreground="Gray"
                       VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Per page:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"
                          Width="58"
                          Padding="6,3"
                          Margin="0,0,12,0" />
                <Button  Command="{Binding PreviousPageCommand}" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Previous" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PageInfoText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button  Command="{Binding NextPageCommand}" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Next" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                       Foreground="Firebrick"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="12,0" />
        </DockPanel>
    </Grid>
</UserControl>

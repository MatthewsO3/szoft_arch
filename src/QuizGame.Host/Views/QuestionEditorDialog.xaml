<Window x:Class="QuizGame.Host.Views.QuestionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="620" Height="640" MinWidth="520" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsDefault="True" Padding="14,7" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Text="{Binding ValidationError, Mode=OneWay}"
                       Foreground="Firebrick"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
        </DockPanel>

        <!-- Form body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Padding="6,5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Question type" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding QuestionTypes}"
                                  SelectedItem="{Binding SelectedTypeChoice, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Padding="6,5" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Question text" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="84"
                         MaxHeight="150"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6,5"
                         Margin="0,0,0,12" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Difficulty" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Difficulties}"
                                  SelectedItem="{Binding SelectedDifficultyChoice, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Padding="6,5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time limit (seconds, 5–300)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TimeLimitText, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                    </StackPanel>
                </Grid>

                <!-- Multiple-choice options -->
                <GroupBox Header="Multiple-choice options (mark the correct answer)"
                          Padding="10"
                          Visibility="{Binding IsMultipleChoice, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0"
                                                     GroupName="CorrectOptionGroup"
                                                     IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"
                                                     ToolTip="Mark as correct option" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LabelText, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Options A and B are required; C and D are optional (fill in order)."
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>

                <!-- Estimation fields -->
                <GroupBox Header="Estimation answer"
                          Padding="10"
                          Visibility="{Binding IsEstimation, Converter={StaticResource B2V}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Correct number" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CorrectNumberText, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit (optional, e.g. km)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

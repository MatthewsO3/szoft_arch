<Window x:Class="QuizGame.Host.Views.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage categories"
        Width="480" Height="460" MinWidth="420" MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="14,6" />
            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                       Foreground="Firebrick"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
        </DockPanel>

        <!-- Add row -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Padding="14,6" Margin="8,0,0,0" />
            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,5"
                     ToolTip="New category name">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Rename / Delete selected category -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteCommand}" Padding="12,6" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding RenameCommand}" Padding="12,6" Margin="8,0,0,0" />
            <TextBox Text="{Binding RenameCategoryName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,5"
                     ToolTip="Rename selected category" />
        </DockPanel>

        <!-- Category list -->
        <ListBox ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 DisplayMemberPath="Name" />
    </DockPanel>
</Window>

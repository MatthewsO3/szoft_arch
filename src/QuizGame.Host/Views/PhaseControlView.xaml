<UserControl x:Class="QuizGame.Host.Views.PhaseControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="StepPillBase" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepTextBase" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="StepArrowStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="→" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </UserControl.Resources>

    <Border Background="#F9FAFB"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button
                            Command="{Binding StartGameCommand}"
                            Style="{StaticResource StartGameButton}"
                            FontWeight="SemiBold"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            ToolTip="Move from Lobby to Base selection once enough connected players have joined">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Start game" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                            Command="{Binding NextPhaseCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            ToolTip="Advance to the next phase when no round or territory pick is pending">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="SkipForward" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Next phase" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                            Command="{Binding EndGameCommand}"
                            Style="{StaticResource EndGameButton}"
                            Padding="12,6"
                            ToolTip="End Duel early and show final results">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="CircleStop" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="End game" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <WrapPanel VerticalAlignment="Center">
                    <!-- 1. Lobby -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLobbyCompleted}" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLobby}" Value="True" />
                                            <Condition Binding="{Binding HasRoom}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1. Lobby">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLobbyCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLobby}" Value="True" />
                                            <Condition Binding="{Binding HasRoom}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource StepArrowStyle}" />

                    <!-- 2. Base selection -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBaseSelectionCompleted}" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBaseSelection}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2. Base selection">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBaseSelectionCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBaseSelection}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource StepArrowStyle}" />

                    <!-- 3. Conquest -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConquestCompleted}" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConquest}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3. Conquest">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConquestCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConquest}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource StepArrowStyle}" />

                    <!-- 4. Expansion -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpansionCompleted}" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpansion}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="4. Expansion">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpansionCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExpansion}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource StepArrowStyle}" />

                    <!-- 5. Duel -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuelCompleted}" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDuel}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="5. Duel">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDuelCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDuel}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource StepArrowStyle}" />

                    <!-- 6. Results -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepPillBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResults}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="6. Results">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StepTextBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResults}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </DockPanel>

            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="9,6"
                    Margin="0,8,0,0">
                <StackPanel>
                    <DockPanel>
                        <icons:PackIconLucide Kind="Info"
                                               Width="16"
                                               Height="16"
                                               Foreground="#2563EB"
                                               VerticalAlignment="Top"
                                               Margin="0,1,8,0" />
                        <Border DockPanel.Dock="Right"
                                Background="#FEF3C7"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasActivePickCountdown, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Hourglass"
                                                       Width="13"
                                                       Height="13"
                                                       Foreground="#92400E"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                <TextBlock Text="{Binding PickCountdownText, Mode=OneWay}"
                                           Foreground="#92400E"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusGuidance, Mode=OneWay}"
                                   Foreground="#4B5563"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding PickTimeRemainingFraction, Mode=OneWay}"
                                 Maximum="1"
                                 Height="4"
                                 Margin="0,6,0,0"
                                 Background="#E2E8F0"
                                 Foreground="#F59E0B"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Pick time remaining"
                                 Visibility="{Binding HasActivePickCountdown, Converter={StaticResource B2V}}" />
                </StackPanel>
            </Border>

            <Border Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,5"
                    Margin="0,8,0,0"
                    Visibility="{Binding SuggestEndConquest, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding ConquestSuggestionText, Mode=OneWay}"
                           Foreground="#92400E"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>

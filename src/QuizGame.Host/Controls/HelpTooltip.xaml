<UserControl x:Class="QuizGame.Host.Controls.HelpTooltip"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="22" Height="22" Cursor="Help" Focusable="True"
             AutomationProperties.Name="Help"
             AutomationProperties.HelpText="{Binding Text, ElementName=Root}"
             ToolTip="{Binding Text, ElementName=Root}">
    <Border CornerRadius="11" Background="Transparent">
        <icons:PackIconLucide Kind="CircleQuestionMark" Width="16" Height="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="#6B7280" IsHitTestVisible="False" />
    </Border>
</UserControl>

<UserControl x:Class="QuizGame.Host.Controls.HelpTooltip"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="20" Height="20" VerticalAlignment="Center" Cursor="Help" Focusable="True"
             AutomationProperties.Name="Help"
             AutomationProperties.HelpText="{Binding Text, ElementName=Root}"
             ToolTip="{Binding Text, ElementName=Root}">
    <Border CornerRadius="10" Background="Transparent">
        <icons:PackIconLucide Kind="CircleQuestionMark" Width="14" Height="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="#9CA3AF" IsHitTestVisible="False" />
    </Border>
</UserControl>
